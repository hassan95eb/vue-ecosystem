{
  "name": "@vue-ecosystem/realtime",
  "version": "0.1.0",
  "description": "Composables for realtime data: WebSocket/SSE connection lifecycle, reconnection and optimistic state.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --root ../.. packages/realtime/tests",
    "test:coverage": "vitest run --root ../.. --coverage packages/realtime/tests",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@vue-ecosystem/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "vue": "^3.5.17"
  },
  "keywords": [
    "vue",
    "vue3",
    "composition-api",
    "typescript",
    "websocket",
    "realtime"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hassan95eb/vue-ecosystem.git",
    "directory": "packages/realtime"
  },
  "homepage": "https://github.com/hassan95eb/vue-ecosystem/tree/main/packages/realtime#readme",
  "bugs": {
    "url": "https://github.com/hassan95eb/vue-ecosystem/issues"
  }
}
