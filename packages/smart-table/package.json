{
  "name": "@vue-ecosystem/smart-table",
  "version": "0.2.0",
  "description": "Data table for Vue 3: sorting, filtering, pagination, virtualised rows.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --root ../.. packages/smart-table/tests",
    "test:coverage": "vitest run --root ../.. --coverage packages/smart-table/tests",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@vue-ecosystem/core": "workspace:*",
    "@vue-ecosystem/virtual-scroll": "workspace:*",
    "@vue-ecosystem/query-builder": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "vue": "^3.5.17"
  },
  "keywords": [
    "vue",
    "vue3",
    "composition-api",
    "typescript",
    "table",
    "data-table",
    "datagrid",
    "sorting",
    "filtering",
    "pagination",
    "virtual-scroll",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hassan95eb/vue-ecosystem.git",
    "directory": "packages/smart-table"
  },
  "homepage": "https://github.com/hassan95eb/vue-ecosystem/tree/main/packages/smart-table#readme",
  "bugs": {
    "url": "https://github.com/hassan95eb/vue-ecosystem/issues"
  }
}
