{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "vitest.config.ts", ".prettierrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsup.config.ts", "vite.config.ts", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "tsconfig.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "package.json"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "package.json"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "inputs": ["src/**", "tests/**", "eslint.config.js"],
      "outputs": []
    },
    "dev": {
      // Packages resolve each other through their published entry points (dist/),
      // so a dev server cannot start until its dependencies have been built once.
      // Without this, `turbo run dev --filter=<app>` fails to resolve the import.
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
